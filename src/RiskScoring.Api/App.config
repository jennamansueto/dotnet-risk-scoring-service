<?xml version="1.0" encoding="utf-8"?>
<!--
  TODO: Migration — in .NET 8, all of these settings move to appsettings.json and are
  accessed via IConfiguration / IOptions<T>. Config transforms (Debug/Release/Staging)
  are replaced by appsettings.{Environment}.json and environment variables.
-->
<configuration>
  <appSettings>
    <!-- Risk scoring thresholds -->
    <add key="ReviewThreshold" value="40" />
    <add key="DeclineThreshold" value="70" />
    <add key="HighAmountThreshold" value="10000" />
    <add key="ExtremeAmountThreshold" value="50000" />
    <add key="SpendDeviationMultiplier" value="3.0" />

    <!-- Country lists (comma-separated ISO 3166-1 alpha-2) -->
    <add key="HighRiskCountries" value="KP,IR,SY,CU,VE,MM,BY" />
    <add key="ElevatedRiskCountries" value="NG,PK,UA,RU,AF" />
  </appSettings>
</configuration>
